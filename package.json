{
  "name": "@bornova/colorpicker",
  "version": "1.1.0",
  "description": "A lightweight and elegant JavaScript color picker written in vanilla JavaScript. Zero dependencies.",
  "keywords": [
    "color",
    "picker",
    "javascript",
    "colorpicker"
  ],
  "homepage": "https://github.com/bornova/ColorPicker#readme",
  "bugs": {
    "url": "https://github.com/bornova/ColorPicker/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bornova/ColorPicker.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/colorpicker.js"
    },
    "./colorpicker.css": "./dist/colorpicker.css",
    "./dist/colorpicker.css": "./dist/colorpicker.css"
  },
  "style": "./dist/colorpicker.css",
  "jsdelivr": "./dist/browser/colorpicker.min.js",
  "unpkg": "./dist/browser/colorpicker.min.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "npm run lint && npm run prettier && npm test",
    "build": "rollup -c && npm run types",
    "format": "npm run prettier:fix && npm run lint:fix",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "test": "node --test",
    "types": "tsc"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-terser": "^1.0.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "rollup": "^4.68.0",
    "typescript": "^7.0.2"
  }
}
